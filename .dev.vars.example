# Copy to .dev.vars and fill in the blanks. .dev.vars is gitignored.
# Non-secret values are pre-filled — they are project config, not credentials.

# --- Google Cloud: Document AI (provisioned) ---
GCP_PROJECT_ID=solidstart-paper-archive
GCP_PROJECT_NUMBER=318291773922
GCP_DOCAI_LOCATION=asia-southeast1
GCP_DOCAI_PROCESSOR_ID=e362ac4f7e80f6e
# Pin the version explicitly rather than relying on the processor default, so a
# Google-side default change cannot silently alter extraction quality.
GCP_DOCAI_PROCESSOR_VERSION=pretrained-ocr-v2.1.1-2025-01-31

# --- Service account (SECRET — do not put the private key in this file) ---
# Create the key yourself:
#   gcloud iam service-accounts keys create .secrets/gcp-sa.json \
#     --iam-account=paper-archive-worker@solidstart-paper-archive.iam.gserviceaccount.com
# then load it with `wrangler secret put GCP_SA_PRIVATE_KEY`.
GCP_SA_CLIENT_EMAIL=paper-archive-worker@solidstart-paper-archive.iam.gserviceaccount.com
GCP_SA_PRIVATE_KEY=

# --- Google OAuth (console-only; no API exists) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Production value lives in wrangler.toml [vars]; override for local dev:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/auth/callback

# --- App auth (interim, until Google sign-in) ---
# Generate: openssl rand -base64 32
APP_BEARER_TOKEN=
# Signs session cookies and encrypts stored Google refresh tokens. Rotating it
# signs everyone out and requires them to reconnect Google. openssl rand -base64 32
SESSION_SECRET=

# --- Anthropic (billed separately from any Claude subscription) ---
ANTHROPIC_API_KEY=

# --- Neon ---
DATABASE_URL=
